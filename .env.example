# Offline demo is the default. Live Gmail requires an explicit --live flag.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set to model IDs available to your account; leave blank for offline mode.
CLASSIFIER_MODEL=
DRAFTER_MODEL=
CLASSIFIER_MAX_TOKENS=180
DRAFTER_MAX_TOKENS=500
AI_TIMEOUT_SECONDS=20
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Label mutation requires gmail.modify, which Google also authorizes for sending.
# The application boundary removes send operations, but OAuth itself does not.
GMAIL_ENABLE_LABEL_MUTATION=false
SANDBOX_DOCKER_IMAGE=secure-inbox-html-inspector:local
# Sponsorship drafts require all three configured policy values.
SPONSORSHIP_ENABLED=false
SPONSORSHIP_APPROVED_TERMS=
SPONSORSHIP_MINIMUM_PRICE=

